<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.26100.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.19041.0</TargetPlatformMinVersion>
    <RootNamespace>FluxBrowser</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\AppIcon.ico</ApplicationIcon>
    <PlatformTarget>x64</PlatformTarget>
    <Platforms>x64</Platforms>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <UseWinUI>true</UseWinUI>
    <WinUISDKReferences>false</WinUISDKReferences>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>

  <!-- Identity shown in the file properties, Task Manager and the About dialog. -->
  <PropertyGroup>
    <Version>0.9.1</Version>
    <AssemblyVersion>0.9.1.0</AssemblyVersion>
    <FileVersion>0.9.1.0</FileVersion>
    <Product>Flux Browser</Product>
    <AssemblyName>FluxBrowser</AssemblyName>
    <Company>World Marketing Labs</Company>
    <AssemblyTitle>Flux Browser</AssemblyTitle>
    <Description>Navegador de escritorio con barras de cristal translúcido sobre Chromium (WinUI 3).</Description>
    <Copyright>Copyright © 2026 World Marketing Labs</Copyright>
    <NeutralLanguage>es</NeutralLanguage>
    <SatelliteResourceLanguages>en;es</SatelliteResourceLanguages>
  </PropertyGroup>

  <!-- Release: fast start-up (ReadyToRun + tiered PGO) and reproducible builds. -->
  <PropertyGroup>
    <Deterministic>true</Deterministic>
    <TieredPGO>true</TieredPGO>
    <PublishReadyToRun>true</PublishReadyToRun>
    <PublishSingleFile>false</PublishSingleFile>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <WarningsAsErrors>$(WarningsAsErrors);nullable</WarningsAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <EmbeddedResource Include="Assets\glass-test.html" />
    <EmbeddedResource Include="Assets\page-host.js" />
    <EmbeddedResource Include="Assets\page-keys.js" />
    <Content Include="Assets\AppIcon.ico" CopyToOutputDirectory="PreserveNewest" />
    <PackageReference Include="CefSharp.OffScreen.NETCore" Version="156.0.150" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2957" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.6.4" />
    <PackageReference Include="Vortice.Direct2D1" Version="3.8.3" />
    <PackageReference Include="Vortice.Direct3D11" Version="3.8.3" />
    <PackageReference Include="Vortice.WinUI" Version="3.8.3" />
  </ItemGroup>

  <!--
    Unpackaged WinUI 3 apps load their compiled XAML (.xbf) and resource index (.pri) from the application folder, but
    `dotnet publish` does not copy them. Without this target the published build fails at start-up with "XAML parsing failed".
  -->
  <Target Name="IncludeXamlOutputsInPublish" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_XamlOutput Include="$(OutDir)*.xbf;$(OutDir)$(TargetName).pri" />
      <ResolvedFileToPublish Include="@(_XamlOutput)" RelativePath="%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>
</Project>
