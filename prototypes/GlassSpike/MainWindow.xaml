<Window x:Class="GlassSpike.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="GlassSpike">
    <Grid x:Name="Root" Background="Transparent">
        <WebView2 x:Name="Web" />
        <!-- Toolbar: only the tint and controls live in XAML; the blur under it is drawn by the page. -->
        <Border x:Name="Toolbar" Height="108" VerticalAlignment="Top" Background="#55FFFFFF">
            <TextBlock x:Name="ToolbarLabel" Text="toolbar (XAML tint)" Margin="16,12" FontSize="18" Foreground="Black" />
        </Border>
        <!-- Shown by the host when the page cannot draw the glass (PDF viewer, error pages, view-source). -->
        <Border x:Name="Fallback" Height="108" VerticalAlignment="Top" Background="#F0F3F3F3" Visibility="Collapsed">
            <TextBlock Text="fallback: solid tint (page has no glass)" Margin="16,12" FontSize="18" Foreground="Black" />
        </Border>
        <Border x:Name="Menu" Width="300" Height="220" Margin="0,116,16,0" HorizontalAlignment="Right" VerticalAlignment="Top"
                CornerRadius="10" Background="#44FFFFFF" BorderBrush="#66FFFFFF" BorderThickness="1" Visibility="Collapsed">
            <StackPanel Margin="16" Spacing="10">
                <TextBlock Text="Menu region (glass sent by message)" FontSize="16" Foreground="Black" />
                <TextBlock Text="Nueva pestaña" FontSize="14" Foreground="Black" />
                <TextBlock Text="Historial" FontSize="14" Foreground="Black" />
                <TextBlock Text="Descargas" FontSize="14" Foreground="Black" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
